{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://hqoaotjhfeimgrgydxlq.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "soi-threading-salon-mcp",
      "version": "0.1.0",
      "title": "SOI Threading Salon"
    },
    "tools": [
      {
        "name": "list_appointments",
        "title": "List appointments",
        "description": "List salon appointments for the signed-in admin. Optionally filter by status or by a preferred_date range (YYYY-MM-DD). Newest first, up to 100 rows.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "new",
                "confirmed",
                "in_progress",
                "completed",
                "cancelled",
                "no_show"
              ],
              "description": "Filter by appointment status."
            },
            "from_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Include appointments with preferred_date on or after this date (YYYY-MM-DD)."
            },
            "to_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Include appointments with preferred_date on or before this date (YYYY-MM-DD)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Row limit. Defaults to 25."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_appointment_status",
        "title": "Update appointment status",
        "description": "Update an existing appointment's status (new, confirmed, in_progress, completed, cancelled, no_show). Admin only.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Appointment id."
            },
            "status": {
              "type": "string",
              "enum": [
                "new",
                "confirmed",
                "in_progress",
                "completed",
                "cancelled",
                "no_show"
              ],
              "description": "New status."
            },
            "internal_notes": {
              "type": "string",
              "maxLength": 1000,
              "description": "Optional internal notes to attach."
            }
          },
          "required": [
            "id",
            "status"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_inquiries",
        "title": "List inquiries",
        "description": "List contact-form inquiries for the signed-in admin. Newest first, up to 100 rows.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "unread_only": {
              "type": "boolean",
              "description": "Only return unread inquiries."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Row limit. Defaults to 25."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
